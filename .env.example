ZHIXING_MODE=demo
ZHIXING_DATA_DIR=data
ZHIXING_MODEL_BASE_URL=https://api.deepseek.com/v1
ZHIXING_MODEL_NAME=
ZHIXING_MODEL_API_KEY=
ZHIXING_MODEL_TIMEOUT=60
ZHIXING_MODEL_DAILY_CALLS=100
# Legacy optional overrides; Settings > Model pricing is preferred.
ZHIXING_MODEL_INPUT_PRICE=
ZHIXING_MODEL_OUTPUT_PRICE=
