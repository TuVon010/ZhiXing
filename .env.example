ZHIXING_JEV_MODE=off
ZHIXING_JEV_API_KEY=
ZHIXING_JEV_MODEL=jev-1.13.0
ZHIXING_JEV_TIMEOUT=5
ZHIXING_JEV_DAILY_CALLS=30
# Legacy per-million input override. Known Jev models now have USD defaults.
ZHIXING_JEV_INPUT_PRICE=
ZHIXING_FEISHU_APP_ID=
ZHIXING_FEISHU_APP_SECRET=
ZHIXING_FEISHU_OWNER=
ZHIXING_FEISHU_GROUPS=[]
ZHIXING_FEISHU_CALENDAR_ID=
ZHIXING_MAIL_ADDRESS=
ZHIXING_MAIL_PASSWORD=
ZHIXING_NOTIFICATIONS=false
