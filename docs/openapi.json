  "components": {
    "schemas": {
      "ActionPlan": {
        "properties": {
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "actions": {
            "items": {
              "$ref": "#/components/schemas/PlannedAction"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Actions"
          }
        },
        "type": "object",
        "required": [
          "summary",
          "actions"
        ],
        "title": "ActionPlan"
      },
      "Approval": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject",
              "edit"
            ],
            "title": "Decision"
          },
          "version": {
            "type": "integer",
            "title": "Version",
            "default": 1
          },
          "args": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Args"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "Approval"
      },
      "CandidateInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "default": ""
          },
          "rules": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rules"
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CandidateInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ItemInput": {
        "properties": {
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "args": {
            "additionalProperties": true,
            "type": "object",
            "title": "Args"
          }
        },
        "type": "object",
        "required": [
          "tool",
          "args"
        ],
        "title": "ItemInput"
      },
      "LocalSettings": {
        "properties": {
          "evolution_enabled": {
            "type": "boolean",
            "title": "Evolution Enabled",
            "default": false
          },
          "feishu_groups": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Feishu Groups"
          }
        },
        "type": "object",
        "title": "LocalSettings"
      },
      "MemoryInput": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": "web:inbox"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "MemoryInput"
      },
      "NormalizedMessage": {
        "properties": {
          "message_id": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Message Id"
          },
          "source": {
            "type": "string",
            "enum": [
              "web",
              "feishu",
              "email",
              "demo"
            ],
            "title": "Source",
            "default": "web"
          },
          "sender_id": {
            "type": "string",
            "title": "Sender Id",
            "default": "owner"
          },
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id",
            "default": "inbox"
          },
          "text": {
            "type": "string",
            "maxLength": 30000,
            "minLength": 1,
            "title": "Text"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "message_id",
          "text"
        ],
        "title": "NormalizedMessage"
      },
      "PlannedAction": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "default": ""
          },
          "tool": {
            "type": "string",
            "enum": [
              "create_todo",
              "update_todo",
              "create_calendar",
              "update_calendar",
              "create_reminder",
              "create_memory_candidate",
              "draft_email",
              "summarize",
              "send_email",
              "send_feishu",
              "sync_todo",
              "sync_calendar",
              "invite_calendar",
